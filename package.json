{
  "name": "wpdbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/entrypoint.ts",
    "start": "node dist/entrypoint.js",
    "test": "vitest run",
    "test:browser": "npm run build && node --test tests/whatsapp-browser.test.mjs",
    "test:docker": "node --test tests/docker-operations.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "execa": "^9.5.2",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "whatsapp-web.js": {
      "@puppeteer/browsers": "3.2.3"
    }
  }
}
